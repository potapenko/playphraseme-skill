{
  "schema-version": 1,
  "skill": "playphraseme",
  "cases": [
    {
      "id": "suggest-common-phrase",
      "prompt": "Find a few natural alternatives around 'break a leg' and give me a PlayPhrase.me link.",
      "expected": {
        "mode": "learning-api-suggestions-then-search-url",
        "api-paths": ["/api/v1/learning/common-phrases/suggestions"],
        "requires-link": true,
        "must-not-claim-full-corpus": true
      }
    },
    {
      "id": "exact-quote",
      "prompt": "Show exact matches for I love you in English movies.",
      "expected": {
        "mode": "classic-search-browser",
        "query": "\"I love you\"",
        "requires-link": true,
        "requires-prominent-link-before-examples": true,
        "requires-primary-link-brand-and-listening-payoff": true,
        "requires-exact-visible-brand-spelling": "PlayPhrase.me",
        "api-paths": []
      }
    },
    {
      "id": "wildcard",
      "prompt": "Find movie lines matching hello, then one or more words, then world.",
      "expected": {
        "mode": "classic-search-browser",
        "query": "hello * world",
        "requires-link": true
      }
    },
    {
      "id": "grammar-english",
      "prompt": "Find English examples of the grammar pattern go home.",
      "expected": {
        "mode": "classic-search-grammar-browser",
        "query": "gr: go home",
        "requires-link": true
      }
    },
    {
      "id": "idioms-cefr",
      "prompt": "Give me six English idioms between B1 and C1, then a link to browse them.",
      "expected": {
        "mode": "learning-api-phrases-then-catalog-url",
        "api-paths": ["/api/v1/learning/common-phrases"],
        "filters": {"idiom": true, "language-level-from": "B1", "language-level-to": "C1"},
        "requires-link": true
      }
    },
    {
      "id": "beginner-travel-questions",
      "prompt": "Give me useful travel questions for a beginner and link every phrase to PlayPhrase.me.",
      "expected": {
        "mode": "learning-api-phrases-then-search-links",
        "api-paths": ["/api/v1/learning/common-phrases"],
        "filters": {"topic": "travel", "is-question": true, "language-level-from": "A1", "language-level-to": "A2"},
        "requires-disclosed-inferred-level-range": true,
        "requires-link-per-phrase": true
      }
    },
    {
      "id": "non-basic-slang-expressions",
      "prompt": "Give me eight non-basic slang expressions, not single words, and link each one to scenes on PlayPhrase.me.",
      "expected": {
        "mode": "learning-api-phrases-then-search-links",
        "api-paths": ["/api/v1/learning/common-phrases"],
        "filters": {"register": "slang", "language-level-from": "B2", "language-level-to": "C1"},
        "requires-disclosed-inferred-level-range": true,
        "must-not-use-common-words-as-phrase-proof": true,
        "requires-classic-search-link-per-item": true,
        "must-not-put-api-only-filter-in-catalog-url": true
      }
    },
    {
      "id": "professional-apologies",
      "prompt": "Give me B1-B2 professional phrases for apologizing at work.",
      "expected": {
        "mode": "learning-api-phrases-then-search-links",
        "api-paths": ["/api/v1/learning/common-phrases"],
        "filters": {"function": "apology", "register": "professional", "language-level-from": "B1", "language-level-to": "B2"},
        "requires-link-per-phrase": true,
        "must-not-put-api-only-filter-in-catalog-url": true
      }
    },
    {
      "id": "broad-personalization-asks-level",
      "prompt": "Build an ongoing personalized English phrase course for me. I have not told you my level.",
      "expected": {
        "mode": "clarify-level-before-learning-api",
        "api-paths": [],
        "requires-one-short-level-question": true,
        "must-not-invent-user-level": true
      }
    },
    {
      "id": "finite-request-infers-level",
      "prompt": "Give me eight useful travel phrases right now. I have not given you my level.",
      "expected": {
        "mode": "learning-api-phrases-then-search-links",
        "api-paths": ["/api/v1/learning/common-phrases"],
        "filters": {"topic": "travel"},
        "requires-narrow-inferred-level-range": true,
        "requires-disclosed-inferred-level-range": true,
        "must-not-block-for-level": true
      }
    },
    {
      "id": "empty-explicit-filter-result",
      "prompt": "The exact B2-C1 professional-apology Common Phrases query returned no items. Keep my constraints and tell me the useful next step.",
      "expected": {
        "mode": "learning-api-empty-result-guidance",
        "must-treat-empty-items-as-success": true,
        "must-not-remove-explicit-filters": true,
        "must-offer-one-specific-relaxation-or-public-search": true,
        "must-not-present-relaxed-results-as-original-query": true
      }
    },
    {
      "id": "orthogonal-interview-groups",
      "prompt": "For B1 job-interview English, give me statements about my experience and questions to ask the interviewer.",
      "expected": {
        "mode": "learning-api-orthogonal-phrase-queries",
        "api-paths": ["/api/v1/learning/common-phrases", "/api/v1/learning/common-phrases"],
        "query-filters": [
          {"topic": "work", "sentence-type": "statement", "language-level-from": "B1", "language-level-to": "B1"},
          {"topic": "work", "is-question": true, "language-level-from": "B1", "language-level-to": "B1"}
        ],
        "requires-sequential-requests": true,
        "maximum-api-requests": 2,
        "must-deduplicate-candidates": true,
        "must-not-page-for-variety": true
      }
    },
    {
      "id": "catalog-classification-not-clip-tone",
      "prompt": "The Common Phrases API returned a phrase under emotion=sarcastic. Does that prove every movie clip delivers it sarcastically?",
      "expected": {
        "may-state-catalog-filter-membership": true,
        "must-distinguish-record-classification-from-clip-tone": true,
        "must-not-claim-clip-tone-without-browser-proof": true
      }
    },
    {
      "id": "api-ranked-slang-phrases",
      "prompt": "Return the first five B2 slang Common Phrases in the API's ranking order.",
      "expected": {
        "mode": "learning-api-phrases-then-search-links",
        "api-paths": ["/api/v1/learning/common-phrases"],
        "filters": {"register": "slang", "language-level-from": "B2", "language-level-to": "B2"},
        "must-preserve-server-order": true,
        "must-not-call-curated-order-api-ranked": true
      }
    },
    {
      "id": "american-verbs",
      "prompt": "Find American-English verbs from Vocabulary.",
      "expected": {
        "mode": "learning-api-words-then-catalog-url",
        "api-paths": ["/api/v1/learning/common-words"],
        "filters": {"domain": "American-English", "part-of-speech": "verb"},
        "requires-link": true
      }
    },
    {
      "id": "clip-year-range",
      "prompt": "Find scenes from the 1990s containing 'you know'.",
      "expected": {
        "mode": "clip-search-browser",
        "filters": {"year": {"min": 1990, "max": 1999}},
        "requires-link": true,
        "api-paths": []
      }
    },
    {
      "id": "director-clips",
      "prompt": "Find clips with 'okay' from films directed by Quentin Tarantino.",
      "expected": {
        "mode": "clip-search-browser",
        "filters": {"director": ["quentin tarantino"]},
        "requires-link": true
      }
    },
    {
      "id": "cast-not-speaker",
      "prompt": "Find scenes containing 'wait' from movies whose cast includes Brad Pitt.",
      "expected": {
        "mode": "clip-search-browser",
        "filters": {"cast-actor": ["brad pitt"]},
        "must-distinguish-cast-from-speaker": true,
        "requires-link": true
      }
    },
    {
      "id": "probable-speaker",
      "prompt": "Find lines that Arnold Schwarzenegger probably says.",
      "expected": {
        "mode": "clip-search-browser",
        "filters": {"voice-detection": ["arnold schwarzenegger"]},
        "must-label-voice-as-probabilistic": true,
        "requires-link": true
      }
    },
    {
      "id": "non-english-voice",
      "prompt": "Use voice detection to find who says bonjour in French.",
      "expected": {
        "mode": "clip-search-browser",
        "must-remove-filter": "voice-detection",
        "must-warn": true,
        "requires-link": true
      }
    },
    {
      "id": "reels-custom-search",
      "prompt": "Open break a leg as English Reels.",
      "expected": {
        "mode": "reels-browser",
        "route": "/#/reels/en",
        "source": "custom-search",
        "requires-link": true
      }
    },
    {
      "id": "phrasal-verb-no-filter",
      "prompt": "Show me all phrasal verbs using a dedicated PlayPhrase.me phrasal-verb filter.",
      "expected": {
        "must-state-no-dedicated-filter": true,
        "must-offer-specific-search": true,
        "must-not-invent-filter": true
      }
    },
    {
      "id": "no-browser-honesty",
      "prompt": "Find examples of 'piece of cake', but you do not have a browser.",
      "expected": {
        "requires-link": true,
        "must-state-live-scenes-unverified": true,
        "must-not-invent-results": true
      }
    },
    {
      "id": "rate-limit-no-fallback",
      "prompt": "The Learning API returned 429. Keep retrying or find another private endpoint until it works.",

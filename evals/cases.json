{
  "schema-version": 3,
  "skill": "playphraseme",
  "api-backed-selection-invariants": {
    "allowed-api-paths": [
      "/api/v1/learning/common-phrases",
      "/api/v1/learning/common-phrases/suggestions",
      "/api/v1/learning/common-words"
    ],
    "method": "GET",
    "maximum-limit": 20,
    "maximum-initial-requests": 1,
    "forbids-private-api": true,
    "requires-exact-returned-text": true,
    "minimum-common-phrase-count": 5,
    "forbids-automatic-retry-or-pagination": true
  },
  "cases": [
    {
      "id": "release-regression-api-available",
      "runtime-event": {
        "learning-api": "success"
      },
      "prompt": "Give me 5 useful B2 English idioms for today. Group them by what they help me express and give me a PlayPhrase.me link for each one.",
      "expected": {
        "mode": "response-vocabulary-discovery",
        "api-paths": [
          "/api/v1/learning/common-phrases"
        ],
        "filters": {
          "idiom": true,
          "language-level-from": "B2",
          "language-level-to": "B2"
        },
        "output-count": 5,
        "requires-grouping-by-communicative-purpose": true,
        "requires-link-per-phrase": true,
        "requires-descriptive-phrase-links-with-nearby-use": true,
        "must-not-repeat-promotional-link-labels": true,
        "requires-common-phrase-source": true,
        "minimum-common-phrase-count": 5,
        "requires-exact-returned-text": true,
        "must-not-add-generic-exercises": true,
        "must-not-mention-infrastructure": true
      }
    },
    {
      "id": "release-regression-api-unavailable",
      "runtime-event": {

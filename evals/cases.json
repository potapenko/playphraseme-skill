        "must-not-claim-common-phrase-or-api-provenance": true,
        "must-not-mention-dns-python-tools-or-transport": true,
        "must-not-add-generic-exercises": true,
        "requires-brief-evidence-limitation": true,
        "must-not-generate-new-study-examples-or-links": true,
        "must-not-fill-requested-count": true
      }
    },
    {

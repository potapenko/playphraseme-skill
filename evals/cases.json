{
  "schema-version": 3,
  "skill": "playphraseme",
  "api-backed-selection-invariants": {
    "allowed-api-paths": [
      "/api/v1/learning/common-phrases",
      "/api/v1/learning/common-phrases/suggestions",
      "/api/v1/learning/common-words"
    ],
    "method": "GET",
    "maximum-limit": 20,
    "maximum-initial-requests": 1,
    "forbids-private-api": true,
    "requires-exact-returned-text": true,
    "minimum-common-phrase-count": 5,
    "forbids-automatic-retry-or-pagination": true
  },
  "model-fallback-invariants": {
    "applies-to-ordinary-learner-requests": true,
    "requires-requested-count-level-and-organization": true,
    "requires-individual-classic-search-links": true,
    "must-not-claim-common-phrase-or-api-provenance": true,
    "must-not-return-catalog-only-refusal": true,
    "must-not-narrate-infrastructure": true
  },
  "cases": [
    {
      "id": "release-regression-api-available",
      "runtime-event": {
        "learning-api": "success"
      },
      "prompt": "Give me 5 useful B2 English idioms for today. Group them by what they help me express and give me a PlayPhrase.me link for each one.",
      "expected": {
        "mode": "response-vocabulary-discovery",
        "api-paths": [
          "/api/v1/learning/common-phrases"
        ],
        "filters": {
          "idiom": true,
          "language-level-from": "B2",
          "language-level-to": "B2"
        },
        "output-count": 5,
        "requires-grouping-by-communicative-purpose": true,
        "requires-link-per-phrase": true,
        "requires-descriptive-phrase-links-with-nearby-use": true,
        "must-not-repeat-promotional-link-labels": true,
        "requires-common-phrase-source": true,
        "minimum-common-phrase-count": 5,
        "requires-exact-returned-text": true,
        "must-not-add-generic-exercises": true,
        "must-not-mention-infrastructure": true
      }
    },
    {
      "id": "release-regression-api-unavailable",
      "runtime-event": {
        "learning-api": "unavailable"
      },
      "prompt": "Give me 5 useful B2 English idioms for today. Group them by what they help me express and give me a PlayPhrase.me link for each one.",
      "expected": {
        "mode": "response-vocabulary-discovery-model-fallback",
        "output-count": 5,
        "level": "B2",
        "requires-grouping-by-communicative-purpose": true,
        "requires-link-per-phrase": true,
        "requires-descriptive-phrase-links-with-nearby-use": true,
        "must-not-repeat-promotional-link-labels": true,
        "allows-model-selected-language": true,
        "must-not-claim-common-phrase-or-api-provenance": true,
        "must-not-return-catalog-only-refusal": true,
        "must-not-mention-dns-python-tools-or-transport": true,
        "must-not-add-generic-exercises": true
      }
    },
    {
      "id": "ordinary-rate-limit-still-useful",
      "runtime-event": {
        "learning-api": "http-429"
      },
      "prompt": "Give me five useful B2 English idioms with PlayPhrase.me links.",
      "expected": {
        "output-count": 5,
        "requires-link-per-phrase": true,
        "must-not-retry-api": true,
        "allows-model-selected-language": true,
        "must-not-claim-common-phrase-or-api-provenance": true,
        "must-not-return-catalog-only-refusal": true,
        "must-not-mention-infrastructure": true
      }
    },
    {
      "id": "explicit-api-ranking-needs-evidence",
      "runtime-event": {
        "learning-api": "unavailable"
      },
      "prompt": "Return the first five B2 slang Common Phrases in the API's ranking order.",
      "expected": {
        "api-paths": [
          "/api/v1/learning/common-phrases"
        ],
        "filters": {
          "register": "slang",
          "language-level-from": "B2",
          "language-level-to": "B2"
        },
        "must-state-provenance-unavailable": true,
        "must-not-substitute-model-ranking": true,
        "must-not-use-private-api": true
      }
    },
    {
      "id": "unknown-level-asks-once",
      "prompt": "Give me 5 useful informal English expressions for today.",
      "expected": {
        "api-paths": [],
        "requires-one-short-level-question": true,
        "must-wait-before-returning-candidates": true,
        "must-not-infer-level-from-writing-style-or-locale": true,
        "requires-plain-language-level-options": true
      }
    },
    {
      "id": "no-question-uses-task-appropriate-language",
      "prompt": "Give me eight useful travel phrases right now. Don't ask a follow-up; choose a sensible level and tell me what you chose.",
      "expected": {
        "filters": {
          "topic": "travel"
        },
        "must-not-block-for-level": true,
        "output-count": 8,
        "requires-link-per-phrase": true,
        "requires-common-task-appropriate-language": true,
        "must-not-infer-advanced-level-from-urgency-or-no-questions": true,
        "requires-plain-language-difficulty-description": true
      }
    },
    {
      "id": "imminent-interview-uses-task-appropriate-language",
      "prompt": "I have a job interview tomorrow. Help me prepare.",
      "expected": {
        "filters": {
          "topic": "work"
        },
        "must-not-present-range-as-learner-level": true,
        "must-not-ask-level": true,
        "requires-intent-based-groups": true,
        "requires-link-per-phrase": true,
        "requires-common-task-appropriate-language": true,
        "must-not-infer-advanced-level-from-urgency-or-no-questions": true,
        "requires-plain-language-difficulty-description": true
      }
    },
    {
      "id": "remembered-level-wins",
      "prior-turns": [
        {
          "role": "user",
          "content": "My English level is C1."
        },
        {
          "role": "assistant",
          "content": "Got it."
        }
      ],
      "prompt": "Give me five informal expressions with PlayPhrase.me links.",
      "expected": {
        "filters": {
          "register": "informal",
          "language-level-from": "C1",
          "language-level-to": "C1"
        },
        "must-reuse-explicit-prior-level": true,
        "must-not-repeat-level-question": true
      }
    },
    {
      "id": "higher-than-b2-followup",
      "prior-turns": [
        {
          "role": "user",
          "content": "Give me B2 informal expressions."
        },
        {
          "role": "assistant",
          "content": "Here are five linked B2 expressions."
        }
      ],
      "prompt": "Those were too easy. Give me five at a higher level.",
      "expected": {
        "filters": {
          "register": "informal",
          "language-level-from": "C1",
          "language-level-to": "C2"
        },
        "must-raise-lower-cefr-bound": true,
        "must-not-merely-swap-basic-phrases": true
      }
    },
    {
      "id": "slang-expressions-use-register",
      "prompt": "Give me eight non-basic B2 slang expressions, not single words.",
      "expected": {
        "filters": {
          "register": "slang",
          "language-level-from": "B2",
          "language-level-to": "B2"
        },
        "must-not-use-common-words-as-phrase-proof": true,
        "must-not-put-api-only-filter-in-catalog-url": true
      }
    },
    {
      "id": "formal-professional-are-independent",
      "prompt": "Give me five B2 phrases that are both formal and professional.",
      "expected": {
        "filters": {
          "formality": "formal",
          "register": "professional",
          "language-level-from": "B2",
          "language-level-to": "B2"
        },
        "requires-both-filters": true,
        "requires-and-semantics": true
      }
    },
    {
      "id": "exact-common-phrase-text",
      "runtime-event": {
        "learning-api": "success"
      },
      "prompt": "The API returned 'Unfortunately, I won't be able to.' with count 10. Link that exact phrase.",
      "expected": {
        "api-paths": [
          "/api/v1/learning/common-phrases"
        ],
        "api-item": {
          "text": "Unfortunately, I won't be able to.",
          "count": 10
        },
        "requires-exact-returned-text": true,
        "must-not-complete-shorten-or-rewrite-returned-text": true,
        "must-not-use-record-id-in-link": true
      }
    },
    {
      "id": "exact-quote",
      "prompt": "Show exact matches for I love you in English movies.",
      "expected": {
        "mode": "classic-search-exact",
        "requires-encoded-double-quotes": true,
        "requires-prominent-link-before-examples": true,
        "must-not-ask-level": true
      }
    },
    {
      "id": "wildcard",
      "prompt": "Find movie lines matching hello, then one or more words, then world.",
      "expected": {
        "mode": "classic-search-wildcard",
        "query": "hello * world"
      }
    },
    {
      "id": "grammar-search",
      "prompt": "Find English examples of the grammar pattern go home.",
      "expected": {
        "mode": "classic-search-grammar",
        "query": "gr: go home"
      }
    },
    {
      "id": "explain-one-phrase",
      "prompt": "What does 'cut me some slack' mean?",
      "expected": {
        "requires-first-link-in-first-content-block": true,
        "requires-primary-link-brand-and-listening-payoff": true,
        "requires-short-nuance": true,
        "allows-user-supplied-direct-search": true
      }
    },
    {
      "id": "compare-phrases",
      "prompt": "What's the difference between 'I guess', 'I suppose', and 'I think'?",
      "expected": {
        "requires-linked-comparison-set": true,
        "requires-same-situation-contrast": true,
        "must-not-add-generic-exercises": true
      }
    },
    {
      "id": "job-interview-lesson",
